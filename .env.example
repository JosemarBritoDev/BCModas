# ─────────────────────────────────────────────────────────────────────────────
# BC Modas — variáveis de ambiente para produção
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa-e-secreta

DEBUG=False

# Domínio(s) permitidos (o ponto inicial libera subdomínios)
ALLOWED_HOSTS=bcmodas.duckdns.org,.bcmodas.duckdns.org

# Origens confiáveis para CSRF (admin/checkout sob HTTPS)
CSRF_TRUSTED_ORIGINS=https://bcmodas.duckdns.org,https://*.bcmodas.duckdns.org

DJANGO_LOG_LEVEL=INFO

# ── Carga inicial (executada no start do container web) ──────────────────────
# Popula a fábrica de demonstração (12 modelos, grade de SKUs e preços de
# atacado/varejo). Use True apenas em ambiente de TESTE — nunca em produção real.
SEED_DEMO=False

# ── Domínio público (usado pelo Nginx e pelo Certbot) ────────────────────────
DOMAIN=bcmodas.duckdns.org

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=bcmodas
POSTGRES_USER=bcmodas
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica

# ── CORS (opcional — só se a API for consumida de outro domínio) ─────────────
CORS_ALLOWED_ORIGINS=
